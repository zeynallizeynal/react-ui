{
  "name": "@lucide-ui/otp",
  "type": "module",
  "version": "0.1.1",
  "source": "./src/index.ts",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    }
  },
  "sideEffects": false,
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rimraf dist && rimraf .turbo"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@lucide-ui/context": "workspace:*",
    "@lucide-ui/hooks": "workspace:*",
    "@lucide-ui/utils": "workspace:*"
  },
  "devDependencies": {
    "@lucide-ui/typescript-config": "workspace:*",
    "@types/react": "^19.1.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "latest"
  },
  "peerDependencies": {
    "react": ">19.0.0",
    "react-dom": ">19.0.0"
  }
}
